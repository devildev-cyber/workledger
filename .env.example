# Copy this file to .env in the repository root and adjust it for your machine.
# Never commit .env.

# One of: development, test, production
WORKLEDGER_ENVIRONMENT=development

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORKLEDGER_SECRET_KEY=

# SQLAlchemy database URL. The default creates a SQLite file in backend/.
WORKLEDGER_DATABASE_URL=sqlite:///./workledger.db

# Optional. No email is sent anywhere yet: messages are written as .eml files that you can
# open in a mail client, such as invitation and password reset links.
# WORKLEDGER_EMAIL_OUTBOX_DIR=./outbox
# WORKLEDGER_EMAIL_FROM=WorkLedger <no-reply@workledger.local>

# Optional. Where the browser app runs; invitation links point here.
# WORKLEDGER_FRONTEND_URL=http://localhost:5173
# WORKLEDGER_INVITATION_VALID_DAYS=7

# Optional. A sign-in lasts at most this many hours...
# WORKLEDGER_SESSION_MAX_AGE_HOURS=168
# ...and ends sooner after this many hours without activity.
# WORKLEDGER_SESSION_IDLE_TIMEOUT_HOURS=12
