# Copy this file to .env in the repository root and adjust it for your machine.
# Never commit .env.

# One of: development, test, production
WORKLEDGER_ENVIRONMENT=development

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORKLEDGER_SECRET_KEY=

# SQLAlchemy database URL. The default creates a SQLite file in backend/.
WORKLEDGER_DATABASE_URL=sqlite:///./workledger.db

# Optional. No email is sent anywhere yet: messages are written as .eml files that you can
# open in a mail client, such as invitation and password reset links.
# WORKLEDGER_EMAIL_OUTBOX_DIR=./outbox
# WORKLEDGER_EMAIL_FROM=WorkLedger <no-reply@workledger.local>

# Optional. Where the browser app runs; invitation links point here.
# WORKLEDGER_FRONTEND_URL=http://localhost:5173
# WORKLEDGER_INVITATION_VALID_DAYS=7
# WORKLEDGER_PASSWORD_RESET_VALID_MINUTES=60

# Optional. A sign-in lasts at most this many hours...
# WORKLEDGER_SESSION_MAX_AGE_HOURS=168
# ...and ends sooner after this many hours without activity.
# WORKLEDGER_SESSION_IDLE_TIMEOUT_HOURS=12

# Optional. Photos and documents attached to requests are stored in this directory.
# WORKLEDGER_UPLOAD_DIR=./uploads
# WORKLEDGER_MAX_UPLOAD_MEGABYTES=10

# Production. WORKLEDGER_ENVIRONMENT=production refuses to start unless the frontend URL is
# https, the database is not SQLite and email goes through SMTP. See docs/operations.md.
# WORKLEDGER_EMAIL_BACKEND=smtp
# WORKLEDGER_SMTP_HOST=smtp.example.com
# WORKLEDGER_SMTP_PORT=587
# WORKLEDGER_SMTP_USERNAME=
# WORKLEDGER_SMTP_PASSWORD=
# WORKLEDGER_SMTP_SECURITY=starttls

# Brute-force limits. Failures are counted per account and per network address.
# WORKLEDGER_SIGN_IN_MAX_FAILURES=5
# WORKLEDGER_SIGN_IN_MAX_FAILURES_PER_ADDRESS=30
# WORKLEDGER_SIGN_IN_WINDOW_MINUTES=15
# WORKLEDGER_RESET_REQUESTS_PER_HOUR=5
# WORKLEDGER_RESET_REQUESTS_PER_ADDRESS_PER_HOUR=20
# Set to true ONLY behind a reverse proxy that you control: the network address then comes
# from the last X-Forwarded-For entry. Otherwise anyone could pick their own address.
# WORKLEDGER_TRUST_FORWARDED_FOR=false
