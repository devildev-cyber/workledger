# Copy this file to .env in the repository root and adjust it for your machine.
# Never commit .env.

# One of: development, test, production
WORKLEDGER_ENVIRONMENT=development

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORKLEDGER_SECRET_KEY=

# SQLAlchemy database URL. The default creates a SQLite file in backend/.
WORKLEDGER_DATABASE_URL=sqlite:///./workledger.db

# Optional. A sign-in lasts at most this many hours...
# WORKLEDGER_SESSION_MAX_AGE_HOURS=168
# ...and ends sooner after this many hours without activity.
# WORKLEDGER_SESSION_IDLE_TIMEOUT_HOURS=12
