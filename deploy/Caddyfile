# The one public entrance. It serves the browser app, forwards /api to the API, and gets and
# renews an HTTPS certificate for the domain by itself (a real domain whose DNS points here).
# With no domain set it serves https://localhost using Caddy's own local certificate.
{$WORKLEDGER_DOMAIN:localhost} {
	encode zstd gzip

	# Large enough for a 10 MB upload plus overhead; anything bigger never reaches the API.
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		# Any other path is a screen of the app, which the browser routes itself.
		try_files {path} /index.html
		file_server
	}
}
