# Copy to .env in this folder. Never commit .env. Details: docs/operations.md

# The public address, without https://. Its DNS must point at this machine for a real
# certificate. Leave as localhost to try the setup on your own computer.
WORKLEDGER_DOMAIN=localhost

# Ports published on this machine. Change only if 80 and 443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443

# Database. Use letters and digits only in the password (it goes inside a URL).
POSTGRES_USER=workledger
POSTGRES_DB=workledger
POSTGRES_PASSWORD=

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs everyone out and resets the sign-in lock counts.
WORKLEDGER_SECRET_KEY=

# Must be the public address people type, with https://. Links in emails point here.
WORKLEDGER_FRONTEND_URL=https://localhost

# Email. Production refuses to start without SMTP.
WORKLEDGER_EMAIL_BACKEND=smtp
WORKLEDGER_EMAIL_FROM=WorkLedger <no-reply@example.com>
WORKLEDGER_SMTP_HOST=
WORKLEDGER_SMTP_PORT=587
# starttls (port 587), ssl (port 465), or none (a trusted local relay only)
WORKLEDGER_SMTP_SECURITY=starttls
WORKLEDGER_SMTP_USERNAME=
WORKLEDGER_SMTP_PASSWORD=

# The web server in front of the API sets X-Forwarded-For, so sign-in limits can tell people apart.
WORKLEDGER_TRUST_FORWARDED_FOR=true

# Optional tuning. These are the defaults.
# WORKLEDGER_SIGN_IN_MAX_FAILURES=5
# WORKLEDGER_SIGN_IN_WINDOW_MINUTES=15
# WORKLEDGER_SESSION_MAX_AGE_HOURS=168
# WORKLEDGER_SESSION_IDLE_TIMEOUT_HOURS=12
# WORKLEDGER_MAX_UPLOAD_MEGABYTES=10
